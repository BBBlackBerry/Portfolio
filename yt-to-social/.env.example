# =============================================================================
# yt-to-social  環境変数テンプレート
# -----------------------------------------------------------------------------
# このファイルを `.env` にコピーして、実際の値を入れてください。
#   cp .env.example .env
#
# 必要なものは大きく分けて3種類:
#   1. Google Gemini API  -- テキスト生成 (投稿文) と 画像生成
#   2. X (Twitter) API    -- X投稿用
#   3. Threads (Meta) API -- Threads投稿用
#
# Anthropic Claude API は任意 (TEXT_PROVIDER=claude のときだけ必要)。
# YouTube字幕は yt-dlp + youtube-transcript-api で取得するためAPIキー不要。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Google Gemini API  [必須]
# -----------------------------------------------------------------------------
# テキスト生成 (X/Threads 投稿文) と 画像生成 (Nano Banana) の両方に使用。
#   取得: https://aistudio.google.com/apikey
#   ※ Gemini Pro プランで発行したAPIキーをそのまま貼り付けてください
#   ※ 画像生成は無料枠でOK (gemini-2.5-flash-image / Nano Banana)
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 投稿文生成のプロバイダ切替 (gemini | claude)
#   gemini : Google Gemini を使う (GOOGLE_API_KEY が必要)  ★既定
#   claude : Anthropic Claude を使う (ANTHROPIC_API_KEY が必要)
TEXT_PROVIDER=gemini

# 投稿文生成モデル (2026-05 時点 / コスト×品質バランスで gemini-2.5-pro を既定)
#   gemini-2.5-pro            : 安定GA Pro / コスト ≈ 3.x Pro の半分・既定 ★
#   gemini-pro-latest         : 常に最新Proを自動追従するエイリアス (やや高コスト)
#   gemini-3.1-pro-preview    : 最新Pro (preview / 最高品質・最高コスト)
#   gemini-3-pro-preview      : 1世代前Pro (preview)
# さらに節約したい場合: gemini-2.5-flash / gemini-flash-latest
GEMINI_TEXT_MODEL=gemini-2.5-pro

# 画像生成モデル (Google Gemini)
#   gemini-2.5-flash-image         : 既定 (Nano Banana / 無料枠で利用可・★)
#   gemini-3.1-flash-image-preview : 新世代Flash画像 (preview)
#   gemini-3-pro-image-preview     : Nano Banana Pro (最高品質・有料)
IMAGE_MODEL=gemini-2.5-flash-image


# -----------------------------------------------------------------------------
# 2. Anthropic Claude API  [任意 / TEXT_PROVIDER=claude のときだけ必要]
# -----------------------------------------------------------------------------
# 取得: https://console.anthropic.com/  →  API Keys
# 使用モデル: claude-opus-4-7 (高品質) / claude-sonnet-4-6 (コスト重視・既定)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6


# -----------------------------------------------------------------------------
# 3. X (旧Twitter) API  [X投稿に必要]
# -----------------------------------------------------------------------------
# 取得手順:
#   1. https://developer.twitter.com/ で開発者アカウント作成
#   2. Project & App を作成 (User authentication settings で Read & Write 権限を有効化)
#   3. Keys and tokens タブから以下を取得
#
# 注: 投稿には OAuth 1.0a User Context が必要なため API Key/Secret + Access Token/Secret の4点が必須
X_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
X_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
X_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
X_ACCESS_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# 4. Threads (Meta Graph) API  [Threads投稿に必要]
# -----------------------------------------------------------------------------
# 取得手順:
#   1. https://developers.facebook.com/ で開発者アカウント作成
#   2. アプリ作成 → Threads APIをプロダクト追加
#   3. アプリ審査 (threads_basic, threads_content_publish の権限申請)
#   4. https://developers.facebook.com/docs/threads/get-started/long-lived-tokens
#      の手順で長期アクセストークン (60日) を発行
#
# 補足: 短期トークンは1時間で失効するので必ずlong-lived tokenに変換すること
THREADS_APP_ID=xxxxxxxxxxxxxxxx
THREADS_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
THREADS_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx        # long-lived
THREADS_USER_ID=xxxxxxxxxxxxxxxx                            # 自分のThreads User ID (数字)


# -----------------------------------------------------------------------------
# 5. アプリ設定  [任意 / 既定値あり]
# -----------------------------------------------------------------------------
APP_PORT=8000                              # FastAPI サーバーポート
APP_HOST=127.0.0.1                         # ローカルのみ
OUTPUT_DIR=./output                        # 生成画像/ログ保存先
DEFAULT_LANGUAGE=ja                        # 字幕の優先言語
DRY_RUN=true                               # true: 投稿APIを叩かずに stdout に出力 (開発時の安全装置)
